# ---------------------------------------------------------------------------
# Vinted Assistant — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Database.
# Default: local SQLite file (works out of the box, zero infra).
DATABASE_URL="file:./dev.db"
# Production (Postgres) example — also change provider in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@localhost:5432/vinted?schema=public"

# ---------------------------------------------------------------------------
# Web Push (browser notifications). Generate a VAPID keypair with:
#   npx web-push generate-vapid-keys
# Leave blank to disable web push (in-app notifications still work).
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Public key must also be exposed to the browser:
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ---------------------------------------------------------------------------
# Vinted data adapter.
#   mock  -> deterministic fake data for development/testing. Clearly labeled as
#            MOCK in the UI. Never presented as live.
#   http  -> polls Vinted's internal catalog JSON endpoint. UNOFFICIAL. You are
#            responsible for complying with Vinted's Terms of Service. See README.
# ---------------------------------------------------------------------------
VINTED_ADAPTER="mock"

# For the http adapter: the Vinted web base for your region (e.g. https://www.vinted.co.uk,
# https://www.vinted.fr, https://www.vinted.de). Leave default for .com.
VINTED_BASE_URL="https://www.vinted.com"

# Optional: a User-Agent string to send with polling requests.
VINTED_USER_AGENT="Mozilla/5.0 (compatible; VintedAssistant/1.0; personal use)"

# Optional: path to a cookie string file the http adapter will send. Vinted's
# web endpoints often require an anonymous session cookie. See README for how to
# obtain one yourself. Leave blank to attempt anonymous requests.
# The app NEVER asks you to paste your password; cookies are YOUR responsibility.
VINTED_COOKIE=""

# ---------------------------------------------------------------------------
# Worker / monitoring
# ---------------------------------------------------------------------------
# Minimum seconds between polls per search. Keep this reasonable to avoid rate
# limits and to be a good citizen. Minimum enforced: 30s.
MONITOR_POLL_INTERVAL_SEC="60"

# Shared secret so only the worker (or an authenticated cron) can trigger a
# monitor tick via the API. Generate a random string.
WORKER_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# Mobile app (Android) support
# ---------------------------------------------------------------------------
# CORS origin allowed to call /api/* . The React Native app is a different
# origin, so the API allows all origins by default ("*"). To restrict it, set
# this to your app/site origin. Expo push needs no server key for EAS builds.
ALLOWED_ORIGIN="*"

# Node env
NODE_ENV="development"
