# React Native (Expo) app environment.
# These are build-time public values (EXPO_PUBLIC_*). Do NOT put secrets here —
# all secrets stay on the backend.

# Base URL of your deployed Vinted Assistant backend (the Next.js app).
# Examples:
#   Production:        https://vinted-assistant.yourdomain.com
#   Android emulator:  http://10.0.2.2:3000   (10.0.2.2 = host machine's localhost)
#   Physical phone on  http://192.168.1.50:3000  (your computer's LAN IP; the
#     same Wi-Fi; phone can't reach "localhost")
EXPO_PUBLIC_API_BASE_URL="https://your-backend.example.com"
